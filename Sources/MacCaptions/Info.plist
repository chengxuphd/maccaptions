<dict>
    <key>CFBundleIdentifier</key><string>io.github.chengxuphd.maccaptions</string>
    <key>CFBundleName</key><string>MacCaptions</string>
    <key>LSUIElement</key><true/>
    <key>NSAppTransportSecurity</key><dict><key>NSAllowsLocalNetworking</key><true/></dict>
    <key>NSLocalNetworkUsageDescription</key><string>MacCaptions sends caption text to the translation server you chose on your local network.</string>
